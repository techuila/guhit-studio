{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "cursor://*" },
        { "url": "vscode:*" },
        { "url": "vscode-insiders:*" },
        { "url": "lmstudio://*" },
        { "url": "goose://*" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$APPDATA/claude-desktop/*" }
      ]
    },
    "dialog:default",
    "updater:default",
    "process:allow-restart"
  ]
}
